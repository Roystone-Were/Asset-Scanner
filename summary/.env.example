# Xana Asset Summary - environment (set these in Vercel project Settings > Environment Variables)
# Copy to .env.local for local `vercel dev`.

# Microsoft Entra / app-only access (the app authenticated as itself, not a user)
TENANT=refrontiergroup.onmicrosoft.com
CLIENT_ID=7caa51af-9f32-42d8-8264-da5b97c2f8eb
# Server-to-server client secret (NOT the cert; MSAL uses this on the backend).
CLIENT_SECRET=

# SharePoint list to summarise (source of truth)
SITE_URL=https://refrontiergroup.sharepoint.com/sites/xanalifeTechData
LIST_NAME=Xana Asset Inventory

# Secret that the dashboard must send to call the API (query: ?key=...  or header: x-summary-key)
SUMMARY_ACCESS_KEY=

# Admin emails (comma-separated) - shown as ADMIN badge, future RLS gate
ADMIN_EMAILS=roystone@xanalife.com

# Optional: pre-resolved ids to skip discovery (faster; leave blank for auto-discover)
SITE_ID=
LIST_ID=

# Xana Asset System - backend environment (Vercel project Settings > Environment Variables)
# Copy to .env.local for local `vercel dev`. Never commit real values.

# --- Supabase (source of truth) ---
SUPABASE_URL=https://irqrnyixizzorvfmtvag.supabase.co
# Service role secret - server-side only, NEVER in browser code
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the database sends when poking the sync worker (pg_net + app_config.sync_worker_key)
SYNC_ACCESS_KEY=

# Where emailed invite links land (defaults to the production /login)
INVITE_REDIRECT_TO=https://asset-system-tau.vercel.app/login

# --- SharePoint mirror (read-only; driven by api/sharepoint-sync.js) ---
TENANT=refrontiergroup.onmicrosoft.com
CLIENT_ID=7caa51af-9f32-42d8-8264-da5b97c2f8eb
CLIENT_SECRET=
SITE_URL=https://refrontiergroup.sharepoint.com/sites/xanalifeTechData
LIST_NAME=Xana Asset Inventory
# Optional pre-resolved ids to skip discovery
SITE_ID=
LIST_ID=

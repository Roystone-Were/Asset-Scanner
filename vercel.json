{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/login/:path*", "destination": "/login/:path*" },
    { "source": "/login", "destination": "/login/index.html" },
    { "source": "/admin/:path*", "destination": "/admin/:path*" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/assets", "destination": "/assets/index.html" },
    { "source": "/dashboard/:path*", "destination": "/summary/:path*" },
    { "source": "/dashboard", "destination": "/summary/index.html" },
    { "source": "/scan/:path*", "destination": "/scanner-app/:path*" },
    { "source": "/scan", "destination": "/scanner-app/index.html" }
  ],
  "functions": {
    "api/summary.js": { "memory": 512, "maxDuration": 15 }
  }
}

{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/dashboard/:path*", "destination": "/summary/:path*" },
    { "source": "/dashboard", "destination": "/summary/index.html" },
    { "source": "/scan/:path*", "destination": "/scanner-app/:path*" },
    { "source": "/scan", "destination": "/scanner-app/index.html" }
  ],
  "functions": {
    "api/summary.js": { "memory": 512, "maxDuration": 15 }
  }
}
